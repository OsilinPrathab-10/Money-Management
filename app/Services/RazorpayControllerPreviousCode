     */
    private function applyBusinessLogic(Payment $payment, array $entity)
    {
        $method = $entity['method'] ?? null;

        switch ($payment->payment_type) {

            case 'EMI':
                $emi = Emi::findOrFail($payment->emi_id);

                $emi->update([
                    'payment_reference' => $payment->payment_id,
                    'payment_method'    => $method,
                    'paid_amount'       => round($entity['amount'] / 100, 2),
                    'pending_amount'    => 0,
                    'status'            => 'paid',
                    'paid_date'         => now(),
                ]);

                app(\App\Services\LoanPaymentService::class)
                    ->syncLoanTotals($emi->loan_account_id);
                break;

            case 'PARTIAL':
                app(\App\Services\LoanPaymentService::class)
                    ->processPartialPayment(
                        $payment->loan_account_id,
                        $payment->amount,
                        now(),
                        $method,
                        $payment->payment_id,
                        'Partial payment via Razorpay'
                    );
                break;

            case 'PREPAYMENT':
                app(\App\Services\LoanPaymentService::class)
                    ->processPrepayment(
                        $payment->loan_account_id,
                        $payment->amount,
                        now(),
                        $method,
                        $payment->payment_id,
                        'Prepayment via Razorpay'
                    );
                break;

            case 'FORECLOSURE':
                app(\App\Services\LoanPaymentService::class)
                    ->foreclose($payment->loan_account_id);
                break;
        }
        // 3. Return Response
        return response($result['message'], $result['status']);
    }
