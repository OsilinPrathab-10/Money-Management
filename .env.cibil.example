# API Hub — CIBIL multi-bureau (paste into your .env)
APIHUB_BASE_URL=http://apihub.services
APIHUB_CLIENT_API_ID=your_client_api_id
APIHUB_CLIENT_API_SECRET=your_client_api_secret

# Optional fallbacks if you already use these names
# APIHUB_API_KEY=
# APIHUB_API_SECRET=
# API_KEY=
# SECRET_KEY=

APIHUB_CIBIL_PATH=v3/cibil
APIHUB_CIBIL_MOCK=false
APIHUB_CIBIL_MOCK_FILE=resources/cibil/sample-response.json
APIHUB_CIBIL_LINK_TTL=600

# Set APIHUB_CIBIL_MOCK=true to use sample JSON without calling the bureau.
